EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Легаси-ключи (JWT) — всё ещё работают:
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Новые ключи Supabase (2025+, Settings -> API Keys). Скрипты db:health/db:proof
# принимают оба варианта; приоритет у новых имён:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Опционально для полной автоматизации (миграции/деплой через Management API):
# создать на supabase.com -> Account -> Access Tokens ( НЕ проектные ключи ):
SUPABASE_ACCESS_TOKEN=sbp_...
